# Console browser configuration. Prefer same-origin /console/api through the gateway.
AIMS_UI_CONSOLE_API_BASE=/console/api
AIMS_UI_DEMO_MODE=false

# Website widget browser configuration.
AIMS_UI_WIDGET_API_BASE=https://chat.jonathan-harris.online
AIMS_UI_WIDGET_SITE_ID=jonathan-harris.online
AIMS_UI_WIDGET_ICON_URL=https://assets.jonathan-harris.online/CogniPal.jpg

# Cloudflare Worker non-secret variables.
ENVIRONMENT=production
AIMS_API_BASE_URL=https://app.jonathan-harris.online
# HIVE-UI identity verifier used when no local handoff secret is configured.
HIVE_IDENTITY_VERIFY_URL=https://hive.jonathan-harris.online/api/auth/comms-identity
HIVE_IDENTITY_VERIFY_METHOD=GET
CONSOLE_ALLOWED_ORIGINS=https://chat.jonathan-harris.online
WIDGET_ALLOWED_ORIGINS=https://jonathan-harris.online,https://www.jonathan-harris.online
WIDGET_ALLOWED_SITE_IDS=jonathan-harris.online

# Server-only Worker secrets. Configure using `wrangler secret put`; never commit values.
AIMS_API_KEY=
COMMS_HUB_RBAC_DELEGATION_SECRET=
HIVE_COMMS_HANDOFF_SECRET=        # optional; enables local handoff verification instead of HIVE callback verification
CHAT_SESSION_SECRET=
COGNIPAL_WEBHOOK_SECRET=
COGNIPAL_API_KEY=
