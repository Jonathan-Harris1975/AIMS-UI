name = "aims-ui-gateway"
main = "index.js"
compatibility_date = "2026-08-01"

[assets]
directory = "./dist"
binding = "ASSETS"
run_worker_first = true

[vars]
ENVIRONMENT = "production"
AIMS_API_BASE_URL = "https://zeroth-kara-jonathanharris-3296ed37.koyeb.app"
HIVE_IDENTITY_VERIFY_URL = "https://hive.jonathan-harris.online/api/auth/comms-identity"
HIVE_IDENTITY_VERIFY_METHOD = "GET"
CONSOLE_ALLOWED_ORIGINS = "https://chat.jonathan-harris.online"
WIDGET_ALLOWED_ORIGINS = "https://jonathan-harris.online,https://www.jonathan-harris.online"
WIDGET_ALLOWED_SITE_IDS = "jonathan-harris.online"

[[d1_databases]]
binding = "DB"
database_name = "database-comms-hub"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# Configure with `wrangler secret put`:
# AIMS_API_KEY
# COMMS_HUB_RBAC_DELEGATION_SECRET
# HIVE_COMMS_HANDOFF_SECRET (optional; enables local verification)
# CHAT_SESSION_SECRET
# COGNIPAL_WEBHOOK_SECRET
# COGNIPAL_API_KEY
