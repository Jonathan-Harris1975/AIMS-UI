name = "aims-ui-gateway"
main = "workers/gateway/index.js"
compatibility_date = "2026-08-11"

[vars]
ENVIRONMENT = "production"
AIMS_API_BASE_URL = "https://aims.jonathan-harris.online"
HIVE_IDENTITY_VERIFY_URL = ""
HIVE_IDENTITY_VERIFY_METHOD = "GET"
CONSOLE_ALLOWED_ORIGINS = "https://chat.jonathan-harris.online"
WIDGET_ALLOWED_ORIGINS = "https://jonathan-harris.online,https://www.jonathan-harris.online"
WIDGET_ALLOWED_SITE_IDS = "jonathan-harris.online"

[assets]
directory = "./dist/site"
run_worker_first = ["/console/api/*", "/widget/session", "/widget/sessions/*", "/sessions/*", "/health"]

[[d1_databases]]
binding = "CHAT_DB"
database_name = "aims-cognipal-chat"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# Secrets are configured in Cloudflare, never committed:
# AIMS_API_KEY
# COMMS_HUB_RBAC_DELEGATION_SECRET
# HIVE_COMMS_HANDOFF_SECRET
# CHAT_SESSION_SECRET
# COGNIPAL_WEBHOOK_SECRET
# COGNIPAL_API_KEY
