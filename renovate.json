{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "after 2:30am and before 5:00am on sunday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "automerge": true,
    "minimumReleaseAge": "0 days",
    "labels": [
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 2:30am and before 5:00am on sunday"
    ],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Automerge patch, minor and digest updates once the stability window and required checks pass",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Keep major dependency updates under manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
